{
  "name": "Operaton NiFi Worker",
  "image": "ghcr.io/cachix/devenv/devcontainer:latest",
  "overrideCommand": false,
  "postCreateCommand": "direnv allow",
  "updateContentCommand": "devenv shell -- build",
  "customizations": {
    "vscode": {
      "settings": {
        "bpmnModeler.engineRestUrl": "http://localhost:8080/engine-rest"
      },
      "extensions": [
        "bbenoist.Nix",
        "mkhl.direnv",
        "datakurre.devenv",
        "vscjava.vscode-java-pack",
        "redhat.vscode-xml",
        "datakurre.vscode-operaton-bpmn-js-modeler",
        "datakurre.vscode-operaton-dmn-js-modeler",
        "datakurre.vscode-operaton-form-js-modeler",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ]
    }
  },
  "forwardPorts": [8080, 8081, 8200],
  "portsAttributes": {
    "8080": {
      "label": "Operaton BPM",
      "onAutoForward": "notify"
    },
    "8081": {
      "label": "Apache NiFi",
      "onAutoForward": "notify"
    },
    "8200": {
      "label": "HashiCorp Vault",
      "onAutoForward": "silent"
    }
  }
}
